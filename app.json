{
  "expo": {
    "name": "mobile-syncrobaby",
    "slug": "mobile-syncrobaby",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/iconSyncrobaby.png",
    "scheme": "mobilesyncrobaby",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./src/assets/images/iconSyncrobaby.png",
        "backgroundImage": "./src/assets/images/splash-icon.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.gabryelfcsilva.mobilesyncrobaby"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e026023-76ad-4077-b997-b971b1602c67"
      }
    },
    "owner": "gabryelfcsilva"
  }
}
